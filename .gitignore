*.log
npm-debug.log*
yarn-error.log*
error_log
debug.log

# Node (if you add frontend tooling later)
node_modules/

# Cache & temp
.cache/
*.tmp
*.temp
.phpunit.result.cache
phpunit.xml
/coverage/

# Distribution / local archives
*.zip
*.tar.gz

# Backups & merge artifacts
*.bak
*.orig
*.rej

