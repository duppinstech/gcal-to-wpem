# Normalize line endings for text files
* text=auto eol=lf

*.php text diff=php
*.md text diff=markdown
*.json text
*.lock text

# Archives / binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Windows scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Archives and office files
*.zip binary
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary
